# zoxide
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# starship
command -v starship >/dev/null && eval "$(starship init zsh)"

# ls 色付け（GNU coreutils と BSD/macOS で指定方法が違うので判定して分岐）
if ls --color=auto >/dev/null 2>&1; then
  alias ls='ls --color=auto'   # GNU (Linux)
else
  export CLICOLOR=1             # BSD (macOS)
  alias ls='ls -G'
fi
alias ll='ls -lh'
alias la='ls -lha'

# ghq + fzf (Ctrl+G)
if command -v ghq >/dev/null && command -v fzf >/dev/null; then
  function ghq-fzf() {
    local selected_dir=$(ghq list | fzf --query="$LBUFFER")
    if [ -n "$selected_dir" ]; then
      BUFFER="cd $(ghq root)/${selected_dir}"
      zle accept-line
    fi
    zle clear-screen
  }
  zle -N ghq-fzf
  bindkey '^G' ghq-fzf
fi

# 履歴検索 fzf (Ctrl+H)
# `tail -r` は BSD/macOS 専用なので、Linux では `tac` を使う。
if command -v fzf >/dev/null; then
  if command -v tac >/dev/null; then
    alias _reverse_lines='tac'
  else
    alias _reverse_lines='tail -r'
  fi
  function fzf-history() {
    local selected=$(fc -l 1 | _reverse_lines | fzf +s --query="$LBUFFER" | sed 's/ *[0-9]* *//')
    if [ -n "$selected" ]; then
      BUFFER="$selected"
      CURSOR=$#BUFFER
    fi
    zle redisplay
  }
  zle -N fzf-history
  bindkey '^H' fzf-history
fi
